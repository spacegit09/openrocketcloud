// A shared OpenRocket design. Its content, edit history and saved copies live in the DesignRoom
// actor session named by `room`; this record is for listing and sharing. Its name, people and
// drawing are sealed (web/base44/shared/sealed.js), so the dashboard shows only ciphertext and
// fingerprints; the site reaches it only through the designs function, the room as the service role.
{
  "name": "Design",
  "type": "object",
  "description": "A shared OpenRocket design (name, people and drawing encrypted)",
  "properties": {
    "room": {
      "type": "string",
      "description": "The design's id in links and its live-share room"
    },
    "people": {
      "type": "array",
      "description": "Keyed fingerprints of the owner's and members' email addresses (not reversible)",
      "items": {
        "type": "string"
      }
    },
    "sealed": {
      "type": "string",
      "description": "Encrypted name, owner and members (AES-256-GCM with the app's DATA_KEY secret)"
    },
    "sealed_preview": {
      "type": "string",
      "description": "Encrypted drawing of the rocket for its card (AES-256-GCM with the app's DATA_KEY secret)"
    },
    "version": {
      "type": "integer"
    },
    "edited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sealed"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

// A piece of a long sealed value (web/base44/shared/parts.js). Base44 refuses a record over about
// 20,000 characters, so a sealed field longer than 12,000 characters (a logbook's flight data or
// a picture's preview, a big launch plan, motor file or design drawing) is kept here in pieces,
// and the field holds "parts:<key>". The pieces are ciphertext; only the functions reach them.
{
  "name": "SealedPart",
  "type": "object",
  "description": "A piece of a long encrypted value",
  "properties": {
    "key": { "type": "string", "description": "Which value it belongs to (random)" },
    "i": { "type": "integer", "description": "Its place among the pieces, from 0" },
    "n": { "type": "integer", "description": "How many pieces the value has" },
    "text": { "type": "string", "description": "The piece of ciphertext" }
  },
  "required": ["key", "i", "n", "text"],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

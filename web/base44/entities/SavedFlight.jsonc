// Transition schema while records move to sealed form (web/base44/functions/migrateSealed):
// the sealed fields beside the old plain ones, access rules as before. The final schema, with
// only the sealed fields and closed to direct access, is web/migration/entities/SavedFlight.jsonc.
{
  "name": "SavedFlight",
  "type": "object",
  "description": "A saved Launch Planner study (encrypted)",
  "properties": {
    "owner": {
      "type": "string",
      "description": "Keyed fingerprint of the owner's email address (not reversible)"
    },
    "ref": {
      "type": "string",
      "description": "Its id before records were sealed, if it was moved (links still work)"
    },
    "sealed": {
      "type": "string",
      "description": "Encrypted name, design, launch time, summary and study (AES-256-GCM with the app's DATA_KEY secret)"
    },
    "owner_email": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "design_id": {
      "type": "string"
    },
    "design_name": {
      "type": "string"
    },
    "launch_time": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "data": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": {
      "data.owner_email": "{{user.email}}"
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}

// A custom motor file (.eng RASP or .rse RockSim). OpenRocket gets the motors of everyone a
// design is shared with, so collaborators always see the same motors.
{
  "name": "Motor",
  "type": "object",
  "description": "A custom motor file",
  "properties": {
    "owner_email": { "type": "string" },
    "filename": { "type": "string", "maxLength": 200 },
    "content": { "type": "string" },
    "summary": { "type": "string" }
  },
  "required": ["owner_email", "filename", "content"],
  "rls": {
    "create": { "data.owner_email": "{{user.email}}" },
    "read": { "data.owner_email": "{{user.email}}" },
    "update": { "data.owner_email": "{{user.email}}" },
    "delete": { "data.owner_email": "{{user.email}}" }
  }
}

# Public address of the site (no trailing slash). Google redirects back to
# ${PUBLIC_URL}/auth/google/callback, which must be listed in the OAuth client.
PUBLIC_URL=http://localhost:8080

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID,
# type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict who can sign in (comma separated). Empty = any Google account.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Where the site listens on the host. Use 0.0.0.0 only behind HTTPS (see docker-compose.https.yml).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Capacity: each open design runs one OpenRocket container (~0.6-1.5 GB RAM).
MAX_SESSIONS=20
MAX_SESSIONS_PER_USER=2
SESSION_MEMORY_MB=1536
SESSION_CPUS=2
SESSION_IDLE_MINUTES=15

# Local testing without Google: sign in as any email. Only works when PUBLIC_URL is localhost.
DEV_LOGIN=false

# For docker-compose.https.yml: the public host name (PUBLIC_URL must be https://DOMAIN).
DOMAIN=

# Which published images to run (default: latest from GitHub). Set ORC_VERSION=1.0.0 to pin.
#ORC_VERSION=latest
